# ─────────────────────────────────────────────────────────────
# Cobrix · frontend (Vite). Copia como .env.local (local) o ponlas en Vercel.
# Si dejas estas variables vacías, la app funciona en modo demo con datos mock.
# ─────────────────────────────────────────────────────────────

# URL del backend de agentes (Render) — sin "/" al final
VITE_AGENTS_API_URL=http://localhost:8787

# Supabase → Project Settings → API (la anon key es pública; RLS protege los datos)
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=
